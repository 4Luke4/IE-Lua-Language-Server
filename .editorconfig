# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{c,h}]
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# Infinity Engine .menu files use tabs; keep test fixtures faithful to the format.
[*.menu]
indent_style = tab
