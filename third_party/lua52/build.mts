// Reproducibly builds the official Lua 5.2.4 compiler front end to WebAssembly.
//
//   npm run build:wasm             rebuild third_party/lua52/dist/*
//   npm run build:wasm -- --check  rebuild into a temp dir; fail if it differs from dist/
//
// Requires Emscripten (see EMSCRIPTEN_VERSION) on PATH, e.g. via
// `source .cache/emsdk/emsdk_env.sh`. Inputs are pinned and verified:
// the tarball by its SHA-256 published on https://www.lua.org/ftp/, and the
// compiler by its exact version string.
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const LUA_VERSION = '5.2.4';
const LUA_URL = `https://www.lua.org/ftp/lua-${LUA_VERSION}.tar.gz`;
// Published next to the tarball on https://www.lua.org/ftp/ ("checksum (sha256)").
const LUA_SHA256 = 'b9e2e4aad6789b3b63a056d442f7b39f0ecfca3ae0f1fc0ae4e9614401b69f4b';
// https://github.com/emscripten-core/emsdk tag; keep in sync with .github/workflows/ci.yml.
const EMSCRIPTEN_VERSION = '6.0.13';

// Exactly the CORE_O objects plus lauxlib.o from lua-5.2.4/src/Makefile.
// The standard libraries are deliberately left out: nothing is ever executed.
const SOURCES = [
  'lapi', 'lcode', 'lctype', 'ldebug', 'ldo', 'ldump', 'lfunc', 'lgc', 'llex',
  'lmem', 'lobject', 'lopcodes', 'lparser', 'lstate', 'lstring', 'ltable',
  'ltm', 'lundump', 'lvm', 'lzio', 'lauxlib',
];

const here = dirname(fileURLToPath(import.meta.url));
const root = resolve(here, '..', '..');
const cacheDir = join(root, '.cache', 'lua');
const tarball = join(cacheDir, `lua-${LUA_VERSION}.tar.gz`);

function fail(message: string): never {
  // `::error::` renders as an annotation on GitHub Actions and reads fine locally.
  console.error(`::error title=Lua 5.2 WASM build::${message}`);
  process.exit(1);
}

function sha256(data: Buffer | string): string {
  return createHash('sha256').update(data).digest('hex');
}

function run(command: string, args: string[], cwd: string): string {
  try {
    return execFileSync(command, args, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });
  } catch (error) {
    if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {
      fail(
        command === 'emcc'
          ? `\`emcc\` was not found on PATH. Install Emscripten ${EMSCRIPTEN_VERSION} and run \`source .cache/emsdk/emsdk_env.sh\` first (CONTRIBUTING.md › The Lua 5.2 WebAssembly module).`
          : `\`${command}\` was not found on PATH.`,
      );
    }
    const stderr = error instanceof Error && 'stderr' in error && typeof error.stderr === 'string' ? error.stderr.trim() : '';
    const details = stderr || (error instanceof Error ? error.message : String(error));
    fail(`\`${command} ${args.join(' ')}\` failed in ${relative(root, cwd) || '.'}:\n${details}`);
  }
}

async function fetchTarball(): Promise<void> {
  if (!existsSync(tarball)) {
    mkdirSync(cacheDir, { recursive: true });
    const response = await fetch(LUA_URL);
    if (!response.ok) {
      fail(`Downloading ${LUA_URL} failed: HTTP ${response.status} ${response.statusText}`);
    }
    writeFileSync(tarball, Buffer.from(await response.arrayBuffer()));
  }
  const actual = sha256(readFileSync(tarball));
  if (actual !== LUA_SHA256) {
    rmSync(tarball);
    fail(`${LUA_URL} has SHA-256 ${actual}, expected ${LUA_SHA256}. The cached file was deleted; re-run to download it again.`);
  }
}

function checkCompiler(): void {
  const version = run('emcc', ['--version'], root).split('\n')[0] ?? '';
  // First line looks like: "emcc (Emscripten gcc/clang-like replacement + linker emulating GNU ld) 6.0.13 (<hash>)"
  if (!new RegExp(`\\) ${EMSCRIPTEN_VERSION.replaceAll('.', '\\.')} \\(`).test(version)) {
    fail(`Emscripten ${EMSCRIPTEN_VERSION} is required, found: "${version}". See CONTRIBUTING.md › Building the Lua 5.2 WASM module.`);
  }
}

const DECLARATIONS = `// Generated by third_party/lua52/build.mts — do not edit.
export interface Lua52Module {
  /** Returns 0 (NULL) when the chunk is valid, otherwise a pointer to the compiler message. */
  _ie_validate(source: number, length: number, chunkname: number): number;
  _malloc(size: number): number;
  _free(pointer: number): void;
  HEAPU8: Uint8Array;
  UTF8ToString(pointer: number): string;
}
declare function createLua52(): Promise<Lua52Module>;
export default createLua52;
`;

function build(outDir: string): void {
  const work = mkdtempSync(join(tmpdir(), 'lua52-'));
  try {
    run('tar', ['-xzf', tarball, '-C', work], root);
    const src = join(work, `lua-${LUA_VERSION}`, 'src');
    const shim = join(work, 'validate.c');
    writeFileSync(shim, readFileSync(join(here, 'validate.c')));
    mkdirSync(outDir, { recursive: true });
    run('emcc', [
      // Same defines as the official Makefile (CFLAGS= -O2 -Wall -DLUA_COMPAT_ALL).
      '-O2', '-Wall', '-DLUA_COMPAT_ALL',
      `-I${src}`,
      // Strip the random temp path so the output is byte-for-byte reproducible.
      `-ffile-prefix-map=${work}=.`,
      ...SOURCES.map((name) => join(src, `${name}.c`)),
      shim,
      '-sMODULARIZE=1',
      '-sEXPORT_NAME=createLua52',
      '-sSINGLE_FILE=1',
      '-sENVIRONMENT=node',
      '-sFILESYSTEM=0',
      '-sALLOW_MEMORY_GROWTH=1',
      '-sEXPORTED_FUNCTIONS=_ie_validate,_malloc,_free',
      '-sEXPORTED_RUNTIME_METHODS=UTF8ToString,HEAPU8',
      '-o', join(outDir, 'lua52.js'),
    ], work);
    writeFileSync(join(outDir, 'lua52.d.ts'), DECLARATIONS);
    const digest = sha256(readFileSync(join(outDir, 'lua52.js')));
    writeFileSync(join(outDir, 'lua52.js.sha256'), `${digest}  lua52.js\n`);
  } finally {
    rmSync(work, { recursive: true, force: true });
  }
}

async function main(): Promise<void> {
  const check = process.argv.includes('--check');
  await fetchTarball();
  checkCompiler();
  const committed = join(here, 'dist');
  if (!check) {
    build(committed);
    console.log(`Built ${relative(root, join(committed, 'lua52.js'))} (${readFileSync(join(committed, 'lua52.js.sha256'), 'utf8').trim()})`);
    return;
  }
  const scratch = mkdtempSync(join(tmpdir(), 'lua52-check-'));
  try {
    build(scratch);
    for (const file of ['lua52.js', 'lua52.d.ts', 'lua52.js.sha256']) {
      const expectedPath = join(committed, file);
      if (!existsSync(expectedPath)) {
        fail(`${relative(root, expectedPath)} is missing. Run \`npm run build:wasm\` and commit the result.`);
      }
      const expected = readFileSync(expectedPath);
      const actual = readFileSync(join(scratch, file));
      if (!expected.equals(actual)) {
        fail(
          `${relative(root, expectedPath)} is not reproducible: committed SHA-256 ${sha256(expected)}, ` +
            `fresh build ${sha256(actual)}. Rebuild with \`npm run build:wasm\` (Emscripten ${EMSCRIPTEN_VERSION}) and commit.`,
        );
      }
    }
    console.log('third_party/lua52/dist matches a fresh build byte for byte.');
  } finally {
    rmSync(scratch, { recursive: true, force: true });
  }
}

await main();
