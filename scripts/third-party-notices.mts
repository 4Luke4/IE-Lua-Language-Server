// Generates THIRD_PARTY_NOTICES.md from what esbuild actually bundled.
//
//   npm run package && node scripts/third-party-notices.mts           write the file
//   npm run package && node scripts/third-party-notices.mts --check   fail if it is out of date
//
// Sources: dist/{client/extension,server/server}.meta.json (esbuild metafiles).
// Every npm package with at least one bundled file is listed with the license
// text it ships. Code under third_party/ is listed with the texts kept in
// third_party/<name>/licenses/.
import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const output = join(root, 'THIRD_PARTY_NOTICES.md');
const metafiles = ['dist/client/extension.meta.json', 'dist/server/server.meta.json'];

function fail(message: string): never {
  console.error(`::error title=Third-party notices::${message}`);
  process.exit(1);
}

interface Metafile {
  inputs: Record<string, unknown>;
}

const inputs = new Set<string>();
for (const relativePath of metafiles) {
  const file = join(root, relativePath);
  if (!existsSync(file)) {
    fail(`${relativePath} is missing. Run \`npm run package\` first.`);
  }
  const metafile = JSON.parse(readFileSync(file, 'utf8')) as Metafile;
  for (const input of Object.keys(metafile.inputs)) {
    inputs.add(input.replaceAll('\\', '/'));
  }
}

// Package directory = path up to and including the last node_modules/<name> or node_modules/@scope/<name>.
const packageDirs = new Set<string>();
for (const input of inputs) {
  const match = /^(.*node_modules\/(?:@[^/]+\/)?[^/]+)\//.exec(input);
  if (match?.[1]) {
    packageDirs.add(match[1]);
  }
}

interface PackageJson {
  name?: string;
  version?: string;
  license?: string;
  homepage?: string;
}

function licenseText(dir: string): string {
  const candidate = readdirSync(join(root, dir)).find((name) => /^licen[cs]e(\.(md|txt))?$/i.test(name));
  if (!candidate) {
    fail(`${dir} has no LICENSE file, so its license text cannot be reproduced. Check the package before shipping it.`);
  }
  return readFileSync(join(root, dir, candidate), 'utf8').trim();
}

const packages = [...packageDirs]
  .map((dir) => {
    const manifest = JSON.parse(readFileSync(join(root, dir, 'package.json'), 'utf8')) as PackageJson;
    if (!manifest.name || !manifest.version || !manifest.license) {
      fail(`${dir}/package.json must declare name, version and license.`);
    }
    return { name: manifest.name, version: manifest.version, license: manifest.license, homepage: manifest.homepage, text: licenseText(dir) };
  })
  .sort((a, b) => a.name.localeCompare(b.name) || a.version.localeCompare(b.version));

const fence = (text: string): string => `\`\`\`text\n${text}\n\`\`\``;
const usesLua52 = [...inputs].some((input) => input.startsWith('third_party/lua52/dist/'));
const lua52License = (name: string): string => readFileSync(join(root, 'third_party', 'lua52', 'licenses', name), 'utf8').trim();

const sections: string[] = [
  '<!-- Generated by scripts/third-party-notices.mts from the esbuild metafiles. Do not edit by hand. -->',
  '# Third-Party Notices',
  '',
  'IE Lua Language Server is proprietary software (see [LICENSE.md](LICENSE.md)). It includes the',
  'third-party components below, each under its own license. Only components whose code is',
  'actually bundled into the published extension are listed.',
  '',
  'Documentation from [EEex-Docs](https://github.com/Bubb13/EEex-Docs) is **not** redistributed:',
  'the extension only links to it.',
];

if (usesLua52) {
  sections.push(
    '',
    '## Lua 5.2.4 (compiled to WebAssembly)',
    '',
    'The official Lua 5.2.4 compiler front end is built to WebAssembly by',
    '[`third_party/lua52/build.mts`](third_party/lua52/build.mts) and used only to check syntax.',
    '',
    fence(lua52License('lua.txt')),
    '',
    '### Emscripten runtime',
    '',
    'The WebAssembly module includes JavaScript glue code and runtime libraries from Emscripten.',
    '',
    fence(lua52License('emscripten.txt')),
    '',
    '### musl libc (linked by Emscripten)',
    '',
    fence(lua52License('musl.txt')),
    '',
    '### Other runtime code linked by Emscripten',
    '',
    '- **dlmalloc** by Doug Lea — released to the public domain (CC0 1.0).',
    '- **compiler-rt** builtins (LLVM) — Apache-2.0 WITH LLVM-exception. The LLVM exception allows',
    '  compiled object forms to be redistributed without the attribution conditions of sections',
    '  4(a), 4(b) and 4(d) of the Apache License 2.0.',
  );
}

sections.push('', '## npm packages', '');
for (const pkg of packages) {
  sections.push(`### ${pkg.name} ${pkg.version}`, '', `License: ${pkg.license}${pkg.homepage ? ` — <${pkg.homepage}>` : ''}`, '', fence(pkg.text), '');
}

const content = `${sections.join('\n').trimEnd()}\n`;
if (process.argv.includes('--check')) {
  const current = existsSync(output) ? readFileSync(output, 'utf8') : '';
  if (current !== content) {
    fail('THIRD_PARTY_NOTICES.md does not match the bundled dependencies. Run `npm run package && node scripts/third-party-notices.mts` and commit the result.');
  }
  console.log(`THIRD_PARTY_NOTICES.md is up to date (${packages.length} npm packages${usesLua52 ? ' + Lua 5.2.4' : ''}).`);
} else {
  writeFileSync(output, content);
  console.log(`Wrote THIRD_PARTY_NOTICES.md (${packages.length} npm packages${usesLua52 ? ' + Lua 5.2.4' : ''}).`);
}
